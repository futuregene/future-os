{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true,
    "esModuleInterop": true, "lib": ["ES2022", "DOM"], "types": ["node"]
  },
  "include": ["src-ts/**/*.ts"]
}
