    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "sha256-universal": "1.2.1",
    "sodium-javascript": "0.8.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^10.13.0",
    "eslint-config-expo": "~58.0.4",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "gen-version": "node ../scripts/version.mjs --gen-ts src/version.generated.ts",
    "postinstall": "npm run gen-version",
    "start": "npm run gen-version && expo start",
    "android": "npm run gen-version && expo run:android",
    "android:device": "npm run gen-version && expo run:android --device",
    "prebuild:android": "npm run gen-version && expo prebuild --platform android",
    "ios": "npm run gen-version && expo run:ios",
    "ios:device": "npm run gen-version && expo run:ios --device",
    "prebuild:ios": "npm run gen-version && expo prebuild --platform ios",
    "typecheck": "npm run gen-version && tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage"
      ]
    }
  }
}
