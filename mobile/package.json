    "@react-native-async-storage/async-storage": "3.1.1",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "fast-text-encoding": "^1.0.6",
    "fflate": "^0.8.3",
    "future-file-handler": "file:modules/future-file-handler",
    "future-share-intent": "file:modules/future-share-intent",
    "i18next": "^26.5.6",
    "lucide-react-native": "^1.61.0",
    "nkeys.js": "^1.1.0",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-i18next": "^17.1.3",
