{
  "name": "@future-os/mobile",
  "version": "0.0.0",
  "main": "index.ts",
  "dependencies": {
    "@future-os/json-preview": "*",
    "@future-os/markdown": "*",
    "@future-os/thread-projection": "*",
    "@nats-io/nats-core": "^3.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.19",
    "expo-build-properties": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "^57.0.1",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-file-system": "57.0.6",
    "expo-image-manipulator": "57.0.15",
    "expo-image-picker": "57.0.15",
    "expo-intent-launcher": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "fast-text-encoding": "^1.0.6",
    "fflate": "^0.8.3",
    "future-file-handler": "file:modules/future-file-handler",
    "future-native-ui": "file:modules/future-native-ui",
    "i18next": "^26.4.1",
    "lucide-react-native": "^1.40.0",
    "nkeys.js": "^1.1.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^10.9.1",
    "eslint-config-expo": "^57.0.2",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "gen-version": "node ../scripts/version.mjs --gen-ts src/version.generated.ts",
    "postinstall": "npm run gen-version",
    "start": "npm run gen-version && expo start",
    "android": "npm run gen-version && expo run:android",
    "android:device": "npm run gen-version && expo run:android --device",
    "prebuild:android": "npm run gen-version && expo prebuild --platform android",
    "ios": "npm run gen-version && expo run:ios",
    "ios:device": "npm run gen-version && expo run:ios --device",
    "prebuild:ios": "npm run gen-version && expo prebuild --platform ios",
    "typecheck": "npm run gen-version && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "overrides": {
    "uuid": ">=11.1.1",
    "js-yaml@3": "^3.15.1",
    "js-yaml@4": "^4.3.1",
    "nanoid": "^3.3.17"
  },
  "private": true
}
