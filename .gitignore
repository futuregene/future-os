# Binaries
/cobalt
/cobalt-web
/pi
/pi-web
*.exe
*.test
**/.DS_Store

# Go
*.out
# ...except the golden test fixtures: committed reference outputs that
# the CLI diff harness (cli/tests/diff-ts-rust.sh) records with --record
# and compares against in check mode.
!cli/tests/golden/**
vendor/

# Rust
**/target/
desktop/src-tauri/gen/
# Bundled agent sidecars — built in CI / locally, never committed
desktop/src-tauri/binaries/
*.app/
*.dmg
*.msi
*.AppImage

# Node
desktop/dist/
desktop/.vite/
mobile/.expo/
mobile/android/
mobile/ios/
node_modules/

# Build-time generated version modules (see scripts/version.mjs)
mobile/src/version.generated.ts

# FutureOS local app data
.future/
.logs/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# IDE
.idea/
.vscode/
*.swp
*.swo
bin/
/log
# Python cache
channel/
*.orig
.claude/

# Windows / MSYS2 artifacts
/NUL
*.bun-build

# Profiling output (make profile-agent / profile-quick)
/profile-results/
# The agent writes a flamegraph to its cwd under --profile-seconds (e.g.
# agent/agent-profile.svg when cli_smoke tests run with the package dir as
# cwd) — ignore at any level; the file is no longer tracked.
agent-profile.svg

# Coverage reports (scripts/coverage.sh)
/coverage/
# Frontend coverage output (vitest --coverage / jest --coverage)
desktop/coverage/
mobile/coverage/

# loop control plane runtime state (never commit)
.codex/
.future/loop/
desktop/node_modules
FUTURE.md
coverage-agent-lcov.info
*.profraw
