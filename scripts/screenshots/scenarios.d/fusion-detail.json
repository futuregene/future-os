    "fusion-detail-remote": {
      "url": "http://localhost:5299/shot/?lang=zh",
      "steps": [
        {
          "wait": 1800
        },
        {
          "tapText": "重画森林图并核对置信区间"
        },
        {
          "wait": 1200
        },
        {
          "eval": "(async () => {const {emitFutureEvent}=await import('/src/lib/futureEvents.ts');const {fetchRemoteToolTarget}=await import('/src/features/remote-peer/remoteToolTarget.ts');emitFutureEvent('inspect-fusion',{runId:'remote-fusion-run',toolCallId:'remote-fusion-call',resolveTarget:input=>fetchRemoteToolTarget({...input,desktopId:'desktop_studio',sessionId:'rs_forest'})});})()"
        },
        {
          "wait": 700
        },
        {
          "eval": "document.querySelector('[data-fusion-panel=detail] button[aria-expanded]')?.click()"
        },
        {
          "wait": 500
