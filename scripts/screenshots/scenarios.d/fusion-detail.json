          "eval": "(() => {const p=document.querySelector('[data-fusion-panel=detail]');if(!p?.querySelector('[data-fusion-public-output]')?.textContent.includes('建议 SQLite'))throw new Error('remote discussion read failed');return 'remote host reader opens the shared detail panel';})()"
        },
        {
          "shot": "d-fusion-detail-remote.png"
