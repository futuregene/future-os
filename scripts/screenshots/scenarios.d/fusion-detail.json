          "wait": 300
        },
        {
          "tap": "查看讨论明细"
        },
        {
          "wait": 900
        },
        {
          "eval": "document.querySelector('[data-fusion-panel=detail] button[aria-expanded]')?.click()"
        },
        {
          "wait": 700
        },
        {
          "eval": "(() => {const p=document.querySelector('[data-fusion-panel=detail]');if(!p||!p.textContent.includes('最终结论')||!p.textContent.includes('建议 SQLite'))throw new Error('missing conclusion or public model response');if(p.scrollWidth>p.clientWidth+1)throw new Error('horizontal overflow');return 'discussion and public response visible';})()"
        },
        {
          "shot": "d-fusion-detail.png"
        }
      ]
    },
