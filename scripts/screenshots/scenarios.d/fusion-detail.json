    "fusion-detail-from-runs": {
      "url": "http://localhost:5299/shot/?fusion=1&lang=zh",
      "steps": [
        {
          "wait": 1400
        },
        {
          "tap": "展开上下文面板"
        },
        {
          "eval": "(() => {const s=document.querySelector('#context-panel-view');s.value='runs';s.dispatchEvent(new Event('change',{bubbles:true}));})()"
        },
        {
          "wait": 500
        },
        {
          "eval": "(() => {const row=document.querySelector('[data-runs-scroll] [role=button]');if(!row?.textContent.includes('本地任务列表第一版采用 SQLite'))throw new Error('Fusion row missing its question');row.click();})()"
        },
        {
          "wait": 700
        },
        {
          "eval": "(() => {if(!document.querySelector('[data-fusion-panel=detail]')||document.querySelector('#context-panel-view').value!=='fusion')throw new Error('Fusion opened generic inspector');return 'Runs opens the dedicated discussion panel';})()"
        },
