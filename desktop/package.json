{
  "name": "@futureos/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/stabilize-dist-mtimes.mjs && node scripts/check-streaming-worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"shot/**/*.{ts,tsx}\" \"vite.shot.config.ts\" && npm run typecheck",
    "test": "vitest run",
    "stylelint": "stylelint \"src/**/*.css\"",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node ../scripts/build/build-desktop.mjs",
    "desktop:package": "node ../scripts/build/build-desktop.mjs"
  },
  "dependencies": {
    "@future-os/json-preview": "*",
    "@future-os/markdown": "*",
    "@future-os/thread-projection": "*",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/xterm": "6.0.0",
    "i18next": "^26.5.3",
    "katex": "0.18.10",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "^5.28.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "decode-named-character-reference": "^1.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
