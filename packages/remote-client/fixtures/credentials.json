        ],
        "closed": [
          true,
          false
        ]
      },
      "difference": "Closing drops the cancellable Rust service future; TypeScript retains an uncooperative host promise until it settles. Both must prevent late persistence/continuation."
    },
    {
      "id": "client.credentials.isolate-close-second",
      "kind": "renewal",
      "instances": 2,
      "actions": [
        {
          "type": "close",
          "target": 1
        },
        {
          "type": "release",
          "target": 0
        },
        {
          "type": "release",
          "target": 1
        }
      ],
      "expected": {
        "writes": [
          1,
          0
        ],
        "fresh": [
          true,
          false
        ],
        "continuations": [
          1,
          0
        ],
        "closed": [
          false,
          true
        ]
      },
      "difference": "Closing drops the cancellable Rust service future; TypeScript retains an uncooperative host promise until it settles. Both must prevent late persistence/continuation."
    },
    {
      "id": "client.credentials.isolate-retire",
      "kind": "renewal",
      "instances": 2,
      "actions": [
        {
