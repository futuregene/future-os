{
  "version": 1,
  "suite": "client.credentials",
  "nowSec": 1000,
  "cases": [
    {
      "id": "client.credentials.fresh",
      "kind": "expiry",
      "expiry": 1061,
      "malformed": false,
      "expected": {
        "rust": "no_refresh",
        "typescript": "no_refresh"
      },
      "difference": null
    },
    {
      "id": "client.credentials.near-expiry",
      "kind": "expiry",
      "expiry": 1059,
      "malformed": false,
      "expected": {
        "rust": "refresh",
        "typescript": "refresh"
      },
      "difference": null
    },
    {
      "id": "client.credentials.exact-margin",
      "kind": "expiry",
      "expiry": 1060,
      "malformed": false,
      "expected": {
        "rust": "refresh",
        "typescript": "no_refresh"
      },
      "difference": "Rust uses an inclusive 60-second boundary on stored seconds; TypeScript retains its strict millisecond comparison."
    },
    {
      "id": "client.credentials.expires-now",
      "kind": "expiry",
      "expiry": 1000,
      "malformed": false,
      "expected": {
        "rust": "refresh",
        "typescript": "refresh"
      },
      "difference": null
    },
    {
      "id": "client.credentials.expired",
      "kind": "expiry",
      "expiry": 999,
      "malformed": false,
      "expected": {
        "rust": "refresh",
        "typescript": "refresh"
      },
      "difference": null
    },
    {
      "id": "client.credentials.zero-expiry",
      "kind": "expiry",
      "expiry": 0,
      "malformed": false,
      "expected": {
        "rust": "no_refresh",
        "typescript": "invalid"
      },
      "difference": "Rust stored expiry 0 suppresses renewal; TypeScript rejects nonpositive JWT metadata. This is policy only, not authentication acceptance."
    },
    {
      "id": "client.credentials.negative-expiry",
      "kind": "expiry",
      "expiry": -1,
      "malformed": false,
      "expected": {
        "rust": "no_refresh",
        "typescript": "invalid"
      },
      "difference": "Rust nonpositive stored expiry suppresses renewal; TypeScript rejects nonpositive JWT metadata."
    },
    {
      "id": "client.credentials.malformed",
      "kind": "expiry",
      "expiry": 0,
      "malformed": true,
      "expected": {
        "rust": "no_refresh",
        "typescript": "invalid"
      },
      "difference": "Rust receives the host-normalized stored expiry sentinel; TypeScript parses JWT metadata and rejects it before calling refresh."
    },
    {
      "id": "client.credentials.accept",
      "kind": "renewal",
      "instances": 1,
      "actions": [
        {
          "type": "release",
          "target": 0
        }
      ],
      "expected": {
        "writes": [
          1
        ],
        "fresh": [
          true
        ],
        "continuations": [
          1
        ],
        "closed": [
          false
        ]
      },
      "difference": null
    },
    {
      "id": "client.credentials.close-before-result",
      "kind": "renewal",
      "instances": 1,
      "actions": [
        {
          "type": "close",
          "target": 0
        },
        {
          "type": "release",
          "target": 0
        }
      ],
      "expected": {
        "writes": [
          0
        ],
        "fresh": [
          false
        ],
        "continuations": [
          0
        ],
        "closed": [
          true
        ]
      },
      "difference": "Closing drops the cancellable Rust service future; TypeScript retains an uncooperative host promise until it settles. Both must prevent late persistence/continuation."
    },
    {
      "id": "client.credentials.retire-before-result",
      "kind": "renewal",
      "instances": 1,
      "actions": [
        {
          "type": "retire",
          "target": 0
        },
        {
          "type": "release",
          "target": 0
        }
      ],
      "expected": {
        "writes": [
          0
        ],
        "fresh": [
          false
        ],
        "continuations": [
          0
        ],
        "closed": [
          false
        ]
      },
      "difference": null
    },
    {
      "id": "client.credentials.supersede-before-result",
      "kind": "renewal",
      "instances": 1,
      "actions": [
        {
          "type": "supersede",
          "target": 0
        },
        {
          "type": "release",
          "target": 0
        }
      ],
      "expected": {
        "writes": [
          0
        ],
        "fresh": [
          false
        ],
        "continuations": [
          0
        ],
        "closed": [
          false
        ]
      },
      "difference": null
    },
    {
      "id": "client.credentials.commit-before-close",
      "kind": "renewal",
      "instances": 1,
      "actions": [
        {
          "type": "release",
          "target": 0
        },
        {
          "type": "close",
          "target": 0
        }
      ],
      "expected": {
        "writes": [
          1
        ],
        "fresh": [
          true
        ],
        "continuations": [
          1
        ],
        "closed": [
          true
        ]
      },
      "difference": null
    },
    {
      "id": "client.credentials.isolate-close-first",
      "kind": "renewal",
      "instances": 2,
      "actions": [
        {
          "type": "close",
          "target": 0
        },
        {
          "type": "release",
          "target": 1
        },
        {
          "type": "release",
          "target": 0
        }
      ],
      "expected": {
        "writes": [
          0,
