      "kind": "renewal",
      "instances": 2,
      "actions": [
        {
          "type": "supersede",
          "target": 1
        },
        {
          "type": "release",
          "target": 1
        },
        {
          "type": "release",
          "target": 0
        }
      ],
      "expected": {
        "writes": [
