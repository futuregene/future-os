      "x-rust-name": "untrimmed",
      "x-rust-type": "bool",
      "default": false,
      "x-ts-type": "boolean",
      "type": "boolean",
      "description": "Mobile gap-fill integrity reads need the backward page to end flush with the requested cursor; a chunked reader reassembles the reply, so it can opt out of the bridge's byte-budget trim explicitly."
