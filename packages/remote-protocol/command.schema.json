{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://future-os.cn/schemas/remote-command-v2.json",
  "title": "Remote command",
  "description": "Wire command shape. Rust preserves legacy missing-field defaults; TS producers require type. Unknown fields and capabilities remain additive. Credentials and UI types are excluded.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type"
  ],
  "x-version": 1,
