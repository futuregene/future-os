      "x-rust-name": "device_name",
      "x-rust-type": "String",
      "default": "",
      "x-ts-type": "string",
      "type": "string",
      "description": "`secure_ready`: what the client says it is. Optional and additive, so an older client that sends neither is simply \"unknown\" rather than wrong."
    },
    "deviceKind": {
      "x-rust-name": "device_kind",
      "x-rust-type": "String",
      "default": "",
