{
  "name": "@future-os/remote-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./legacy-signature": {
      "types": "./src/legacySignature.ts",
      "import": "./src/legacySignature.ts",
      "default": "./src/legacySignature.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vitest.config.ts",
    "test": "vitest run --reporter=verbose",
    "generate": "python3 scripts/generate.py",
    "check:generated": "python3 scripts/generate.py --check"
  },
  "dependencies": {
    "@future-os/remote-crypto": "*",
    "@future-os/thread-projection": "*",
    "fflate": "^0.8.3",
    "nkeys.js": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "eslint": "^10.9.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
