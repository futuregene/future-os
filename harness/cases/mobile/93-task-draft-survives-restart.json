{
  "id": "mobile-task-draft-survives-restart",
  "surface": "mobile",
  "title": "手机端定时任务：中途退出应用，草稿还在；取消才算放弃",
  "area": "mobile-tasks",
  "priority": "P1",
  "tags": ["mobile", "tasks", "draft"],
  "description": "报告里的现场：在手机上填定时任务，退出去接个电话再回来，表单已经回到空白的新建页，输入的内容全没了。表单很长（名称、提示词、模型、触发器、时区），一次重填代价很大，所以草稿按「桌面 + 任务」存在本地，重新打开时恢复。这个用例把应用杀掉重来（整页重新加载 = 冷启动），再走回新建任务，两个输入框里的字必须还在；随后点「取消」——那是两个刻意的结束之一——草稿才真的被丢掉，下一次打开是空的。",
  "preconditions": "移动端 shot 服务可用；同一浏览器 profile 的 localStorage 保留（用例内部重新加载页面）。",
  "expectations": [
    "填了名称与提示词后重新加载页面，再走回「新建定时任务」，两个字段的值都恢复",
    "点「取消」后重建会话，再打开新建页是空白表单",
    "草稿恢复不依赖「先保存」——表单从未保存过"
  ],
  "steps": [
    { "wait": 1800 },
    { "click": { "text": "稍后再说" }, "note": "关闭开发版更新提示", "optional": true },
    { "wait": 500 },
    { "click": { "text": "全部桌面" } },
    { "wait": 900 },
    { "click": { "text": "管理已配对的桌面…" } },
    { "wait": 1300 },
    { "click": { "aria": "桌面端设置" } },
    { "wait": 1300 },
    { "click": { "text": "定时任务设置" } },
    { "wait": 1600 },
    { "click": { "text": "新建定时任务" } },
    { "wait": 1600 },
    { "click": { "aria": "名称" } },
    { "wait": 300 },
    { "type": "明早的日报" },
    { "click": { "aria": "提示词" } },
    { "wait": 300 },
    { "type": "把今天的提交整理成日报" },
    { "wait": 1200 },
    { "shot": "mobile-task-draft-typed" },
    { "reload": true, "note": "应用被杀掉再打开" },
    { "wait": 2200 },
    { "click": { "text": "稍后再说" }, "optional": true },
    { "wait": 600 },
    { "click": { "text": "全部桌面" } },
    { "wait": 900 },
    { "click": { "text": "管理已配对的桌面…" } },
    { "wait": 1300 },
    { "click": { "aria": "桌面端设置" } },
    { "wait": 1300 },
    { "click": { "text": "定时任务设置" } },
    { "wait": 1600 },
    { "click": { "text": "新建定时任务" } },
    { "wait": 1900 },
    { "assert": { "expr": "document.querySelector('[aria-label=\"名称\"]')?.value === '明早的日报'", "message": "名称从草稿里恢复了" } },
    { "assert": { "expr": "document.querySelector('[aria-label=\"提示词\"]')?.value === '把今天的提交整理成日报'", "message": "提示词从草稿里恢复了" } },
    { "shot": "mobile-task-draft-restored" },
    { "click": { "text": "取消" }, "note": "取消是刻意的结束，草稿应当被丢掉" },
    { "wait": 1200 },
    { "click": { "text": "新建定时任务" } },
    { "wait": 1700 },
    { "assert": { "expr": "document.querySelector('[aria-label=\"名称\"]')?.value === '' && document.querySelector('[aria-label=\"提示词\"]')?.value === ''", "message": "取消之后是空白的新建页" } },
    { "shot": "mobile-task-draft-cleared" }
  ],
  "judge": {
    "criteria": [
      "恢复后的表单读起来就是用户自己填的那一页，不是把字段塞到了错误的位置",
      "取消之后确实是空白页，没有残留半份草稿",
      "截图里没有闪烁中的占位、错误条或重复的表单"
    ],
    "maxImages": 6
  }
}
