    "输入框可用（给 FutureOS 发消息）"
  ],
  "steps": [
    { "wait": 1500 },
    { "click": { "text": "稍后再说" }, "optional": true },
    { "wait": 500 },
    { "click": { "text": "整理两篇文献的结论对比表" } },
    { "wait": 1200 },
    { "expectText": "结论对比" },
    { "expectText": "Frank 等 (2024)" },
    { "assert": { "expr": "!!document.querySelector('textarea[aria-label=\"给 FutureOS 发消息\"]')", "message": "输入框可定位" } },
    { "shot": "mobile-conversation" }
  ]
}
