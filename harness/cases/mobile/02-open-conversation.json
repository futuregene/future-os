{
  "id": "mobile-open-conversation",
  "surface": "mobile",
  "title": "手机端打开会话：转录与输入框",
  "area": "mobile-chat",
  "priority": "P0",
  "tags": ["mobile", "chat"],
  "description": "从首页点开一条真实会话（mock 数据），确认转录、图片、用量与输入框都渲染出来；这是手机端最核心的阅读路径。",
  "preconditions": "移动端 shot 服务在 8099 运行。",
