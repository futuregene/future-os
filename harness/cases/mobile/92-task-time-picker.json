{
  "id": "mobile-task-time-picker",
  "surface": "mobile",
  "title": "手机端定时任务：时间用选择器挑（24 小时都在），保存后列表读得出来",
  "area": "mobile-tasks",
  "priority": "P1",
  "tags": ["mobile", "tasks", "form", "picker"],
  "description": "报告里的一页：设置触发时间时，时间是一个文本框，得用键盘敲；而且键盘一起就把表单底部盖住，滑不到「保存」。修好之后它是选择器：24 个小时、60 分钟、不需要键盘，选完点「完成」。这个用例走完整条新建链路——选模型、选「每天」、用选择器挑 21:30、保存——然后回到列表，新的任务必须带着「每天 21:30」出现（写入真的落到了对端，而不是只关掉了表单）。",
  "preconditions": "移动端 shot 服务可用；任务夹具随 mock 提供，写入在 mock 里是持久的。",
  "expectations": [
    "触发时间字段不是文本输入框（元素不是 input），点它打开选择器",
    "选择器里 24 个小时都在（00 点 … 23 点），且有分钟行与「完成」",
    "选 21 点 + 30 分并「完成」后，字段读作 21:30",
    "保存后回到列表，新任务「早报」在列表里，计划摘要为「每天 21:30」"
  ],
  "steps": [
    { "wait": 1800 },
    { "click": { "text": "稍后再说" }, "note": "关闭开发版更新提示", "optional": true },
    { "wait": 500 },
    { "click": { "text": "全部桌面" } },
    { "wait": 900 },
    { "click": { "text": "管理已配对的桌面…" } },
    { "wait": 1300 },
    { "click": { "aria": "桌面端设置" } },
    { "wait": 1300 },
    { "click": { "text": "定时任务设置" } },
    { "wait": 1600 },
    { "click": { "text": "新建定时任务" } },
    { "wait": 1600 },
    { "click": { "aria": "名称" } },
    { "wait": 300 },
    { "type": "早报" },
    { "click": { "aria": "提示词" } },
    { "wait": 300 },
    { "type": "把今天的提交整理成一份早报" },
    { "wait": 500 },
    { "click": { "text": "DeepSeek V4 Pro · Future" }, "note": "选模型：新建任务不继承默认模型" },
    { "wait": 700 },
    { "click": { "text": "每天" }, "note": "触发器选每天" },
    { "wait": 700 },
    { "assert": { "expr": "document.querySelector('[aria-label=\"时间\"]')?.tagName !== 'INPUT'", "message": "时间是选择器而不是文本框" } },
    { "click": { "aria": "时间" } },
    { "wait": 800 },
    { "expectText": "小时" },
    { "expectText": "分钟" },
    { "expectText": "完成" },
    { "assert": { "expr": "Array.from({ length: 24 }, (_, hour) => String(hour).padStart(2, '0')).every(hour => document.querySelector(`[aria-label=\"${hour} 点\"]`))", "message": "24 个小时都能选到" } },
    { "shot": "mobile-task-time-picker" },
    { "click": { "aria": "21 点" } },
    { "wait": 400 },
    { "click": { "aria": "30 分" } },
    { "wait": 400 },
    { "click": { "text": "完成" } },
    { "wait": 600 },
    { "assert": { "expr": "document.body.innerText.includes('21:30')", "message": "字段读作 21:30" } },
    { "shot": "mobile-task-time-chosen" },
    { "click": { "text": "保存" } },
    { "wait": 2200 },
    { "expectText": "早报", "note": "写入落在对端：新任务出现在列表里" },
    { "expectText": "每天 21:30", "note": "列表摘要读得出选定的时间" },
    { "shot": "mobile-task-created" },
    { "click": { "text": "早报" } },
    { "wait": 1700 },
    { "click": { "text": "编辑" } },
    { "wait": 1700 },
    { "assert": { "expr": "document.body.innerText.includes('21:30')", "message": "重新打开表单，时间还是选的那个" } }
  ],
  "judge": {
    "criteria": [
      "时间选择器在手机上可点、可读，小时与分钟两行都完整，没有把 24 小时挤成一行文本",
      "选中态在截图里看得见（选中的小时/分钟与其它不同）",
      "保存后列表里的新任务带着正确的计划摘要，不是空白或「手动」",
      "整条链路没有出现英文键名、报错条或空页面"
    ],
    "maxImages": 8
  }
}
