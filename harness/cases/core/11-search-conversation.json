{
  "id": "search-conversation",
  "title": "搜索真实会话标题：结果收窄且能打开",
  "area": "search",
  "priority": "P1",
  "tags": ["search", "list"],
  "description": "取首屏实际可见的两行会话：输入其中一行的标题片段后，它仍在结果里，另一行必须消失。用可见行而不是数据库前 N 行，避免分页/分组变化让用例失效。",
  "preconditions": "应用已启动；首屏至少两行会话。",
  "expectations": [
    "搜索框能输入并实时过滤",
    "匹配的会话仍在结果里",
    "不匹配的会话从结果里消失",
    "Escape 关闭搜索后列表恢复"
  ],
  "steps": [
    { "wait": 900 },
    {
      "eval": "window.__rows = [...document.querySelectorAll('[aria-label$=\" 的操作\"]')].map(el => el.getAttribute('aria-label').replace(/ 的操作$/, '')); window.__rows.length",
      "as": "rowCount"
    },
    { "assert": { "expr": "window.__rows.length >= 2", "message": "首屏至少两行会话" } },
    { "eval": "window.__rows[0]", "as": "target" },
    { "eval": "window.__rows[1]", "as": "other" },
    { "eval": "window.__rows[0].slice(0, 6)", "as": "query" },
    { "click": { "aria": "搜索会话" } },
    { "wait": 500 },
    { "shot": "search-open" },
    { "click": { "selector": "input" } },
    { "type": "{{query}}" },
    { "wait": 900 },
    {
      "assert": {
        "expr": "!!document.querySelector('[aria-label=\"{{target}}\"]')",
        "message": "匹配的会话保留在结果里"
      }
    },
    {
      "assert": {
        "expr": "!document.querySelector('[aria-label=\"{{other}}\"]')",
        "message": "不匹配的会话被过滤掉"
      }
    },
    { "shot": "search-results" },
    { "press": "Escape" },
    { "wait": 600 },
    {
      "assert": {
        "expr": "!!document.querySelector('[aria-label=\"{{other}}\"]')",
        "message": "关闭搜索后列表恢复"
      }
    },
    { "shot": "search-closed" }
  ]
}
