{
  "id": "send-right-after-workspace-create",
  "title": "新建工作区后立刻发送：草稿不能被静默丢弃",
  "area": "workspace",
  "priority": "P0",
  "tags": [
    "workspace",
    "edge",
    "race",
    "regression"
  ],
  "query": {
    "slowModels": 10000
  },
  "description": "模型目录被刻意延迟 3 秒（slowModels），模拟新建工作区后立刻输入发送的真实竞态。发送必须被挂起而不是丢弃：草稿留在输入框，目录就绪后再点发送才创建会话。",
  "preconditions": "应用已启动；harness 已准备空目录；模型目录延迟 3s。",
  "expectations": [
    "目录未就绪时发送不会清空草稿，也不会创建会话",
    "草稿在等待期间保持可见"
  ],
  "steps": [
    {
      "wait": 800
    },
    {
      "click": {
        "aria": "新建工作区"
      }
    },
    {
      "waitFor": {
        "selector": "button[aria-label='选择工作区']"
      },
      "timeout": 5000
    },
    {
      "click": {
        "aria": "选择工作区"
      }
    },
    {
      "waitFor": {
        "text": "工作区路径："
      },
      "timeout": 5000
    },
    {
      "click": {
        "selector": "button",
        "text": "打开"
      }
    },
    {
      "waitFor": {
        "text": "使用此项目文件夹及其工作区资源"
      },
      "timeout": 8000
    },
    {
      "wait": 250
    },
    {
      "click": {
        "selector": "[role=textbox]"
      }
    },
    {
      "type": "模型加载前发送的草稿"
    },
    {
      "click": {
        "aria": "发送"
      },
      "note": "此时模型目录仍在加载"
    },
    {
      "wait": 500
    },
    {
      "assert": {
        "expr": "document.querySelector('[role=textbox]').innerText.includes('模型加载前发送的草稿')",
        "message": "发送被挂起后草稿仍留在输入框"
      }
    },
    {
      "db": {
        "sql": "SELECT COUNT(*) AS n FROM threads WHERE deleted_at IS NULL AND status != 'deleted'",
        "as": "before"
      }
    },
    {
      "wait": 800
    },
    {
      "db": {
        "sql": "SELECT COUNT(*) AS n FROM threads WHERE deleted_at IS NULL AND status != 'deleted'",
        "delta": 0,
        "message": "目录就绪前没有创建会话"
      }
    },
    {
      "shot": "draft-held"
    }
  ]
}
