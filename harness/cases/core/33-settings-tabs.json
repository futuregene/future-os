{
  "id": "settings-tabs",
  "title": "设置：全部页签都能打开",
  "area": "settings",
  "priority": "P1",
  "tags": ["settings"],
  "description": "依次打开设置里的通用、快捷键、账号、检查更新、关于、服务器、提供商、模型、Fusion、调试、环境、重置，确认每个页签都有内容，不是空白。",
  "preconditions": "应用已启动。",
  "expectations": ["12 个页签均可打开", "每页有实质内容", "没有初始化错误"],
  "steps": [
    { "wait": 900 },
    { "click": { "text": "设置" } },
    { "wait": 800 },
    { "assert": { "expr": "document.body.innerText.includes('界面语言')", "message": "设置默认打开通用页" } },
    { "click": { "selector": "button", "text": "快捷键" } },
    { "wait": 500 },
    { "shot": "settings-shortcuts" },
    { "click": { "selector": "button", "text": "账号" } },
    { "wait": 600 },
    { "assert": { "expr": "document.querySelector('main')?.innerText.trim().length > 50", "message": "账号页有内容" } },
    { "shot": "settings-account" },
    { "click": { "selector": "button", "text": "检查更新" } },
    { "wait": 600 },
    { "assert": { "expr": "document.querySelector('main')?.innerText.trim().length > 50", "message": "更新页有内容" } },
    { "click": { "selector": "button", "text": "关于" } },
    { "wait": 600 },
    { "assert": { "expr": "document.querySelector('main')?.innerText.trim().length > 50", "message": "关于页有内容" } },
    { "click": { "selector": "button", "text": "服务器" } },
    { "wait": 600 },
    { "assert": { "expr": "document.querySelector('main')?.innerText.trim().length > 50", "message": "服务器页有内容" } },
    { "click": { "selector": "button", "text": "提供商" } },
    { "wait": 600 },
    { "assert": { "expr": "document.querySelector('main')?.innerText.trim().length > 50", "message": "提供商页有内容" } },
    { "click": { "selector": "button", "text": "模型" } },
    { "wait": 600 },
    { "assert": { "expr": "document.querySelector('main')?.innerText.trim().length > 50", "message": "模型页有内容" } },
    { "shot": "settings-models" },
    { "click": { "selector": "button", "text": "Fusion" } },
    { "wait": 600 },
    { "assert": { "expr": "document.querySelector('main')?.innerText.trim().length > 50", "message": "Fusion 页有内容" } },
    { "click": { "selector": "button", "text": "调试" } },
    { "wait": 600 },
    { "assert": { "expr": "document.querySelector('main')?.innerText.trim().length > 50", "message": "调试页有内容" } },
    { "click": { "selector": "button", "text": "环境" } },
    { "wait": 600 },
    { "assert": { "expr": "document.querySelector('main')?.innerText.trim().length > 50", "message": "环境页有内容" } },
    { "click": { "selector": "button", "text": "重置" } },
    { "wait": 600 },
    { "assert": { "expr": "document.querySelector('main')?.innerText.trim().length > 50", "message": "重置页有内容" } },
    { "shot": "settings-reset" }
  ]
}
