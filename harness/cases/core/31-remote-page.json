{
  "id": "remote-page",
  "title": "远程页：单机状态下不空白",
  "area": "remote",
  "priority": "P1",
  "tags": [
    "remote",
    "settings"
  ],
  "description": "从左侧导航打开远程页。夹具报告没有配对设备，页面应给出本机/配对状态的说明，而不是空白。 夹具用 ?peers=held 让第一台机器处于「被另一台已配对设备持有」，好让行内提示真的渲染出来。 夹具用 ?peers=transfer 让第一台机器先处于「被另一台设备持有」，5 秒后把控制权交回，行状态必须跟着变。",
  "preconditions": "应用已启动；?peers=transfer：前 5 秒被持有，之后控制权回到本机。",
  "expectations": [
    "远程页可打开",
    "页面有状态说明",
    "没有错误提示",
    "被持有的机器行里出现「由 <设备> 持有」提示，且宽度贴合文字（不是涂满整列的横幅）",
    "控制权回来后（约 5 秒），该行不再显示「被持有」提示，且行仍在列表里"
  ],
  "steps": [
    {
      "wait": 900
    },
    {
      "click": {
        "selector": "button",
        "text": "远程"
      }
    },
    {
      "wait": 900
    },
    {
      "assert": {
        "expr": "document.querySelector('main')?.innerText.trim().length > 20",
        "message": "远程页有内容"
      }
    },
    {
      "assert": {
        "expr": "!document.body.innerText.includes('本地存储初始化失败')",
        "message": "没有初始化错误"
      }
    },
    {
      "shot": "remote-page"
    },
    {
      "assert": {
        "expr": "(() => {const e=document.querySelector('[data-testid=peer-held]');if(!e)return false;const r=e.getBoundingClientRect();return Math.abs(r.width-e.scrollWidth)<=2 && r.width < e.parentElement.getBoundingClientRect().width;})()",
        "message": "被持有的提示贴合文字宽度，不涂满整列"
      },
      "capture": true
    },
    {
      "wait": 6000
    },
    {
      "assert": {
        "expr": "(() => {const rows=document.querySelectorAll('[data-testid=peer-row]');return rows.length>0 && !document.querySelector('[data-testid=peer-held]');})()",
        "message": "控制权回来后，行不再显示被持有提示（行仍在）"
      },
      "capture": true
    }
  ],
  "query": {
    "peers": "transfer"
  }
}
