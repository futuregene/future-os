{
  "id": "tui-preferences",
  "surface": "tui",
  "title": "TUI 偏好设置：切语言、切主题，重启后仍是同一套",
  "area": "tui",
  "priority": "P0",
  "tags": ["tui", "preferences", "i18n", "theme"],
  "description": "打开偏好设置（ctrl+q）：界面语言从「跟随系统」切到 English，整个界面（输入框提示、状态栏、页脚快捷键）立刻变成英文；再把配色主题从 Dark 换到 One Dark。然后重启这个 TUI（同一台机器、同一份 FUTURE_HOME），确认重启后界面仍是英文、主题仍是 One Dark —— 这两项都写进 tui/settings.json，重启掉就意味着偏好没被记住。",
  "preconditions": "future 与 demo_agent 已构建；FUTURE_HOME 是本次用例自己的目录（里面没有旧的 settings.json）。",
  "expectations": [
    "ctrl+q 打开「偏好设置」浮层，列出界面语言 / 配色主题等行",
    "在「语言」列表里选 English 后，浮层与页脚、输入框提示都变成英文",
    "在主题列表里选 One Dark 后，「配色主题」一行显示 One Dark",
    "关掉浮层后界面仍是英文（输入框提示 Describe the task、状态栏 idle）",
    "重启后首屏仍是英文，偏好设置里仍是 One Dark（偏好被持久化）"
  ],
  "steps": [
    { "wait": 1500 },
    { "assertText": "描述你要做的事", "note": "切换前是中文" },
    { "press": "ctrl+q", "note": "打开偏好设置" },
    { "wait": 1000 },
    { "assertText": "配色主题" },
    { "assertText": "恢复默认偏好" },
    { "shot": "tui-preferences-zh" },
    { "press": "enter", "note": "第一行「界面语言」打开语言列表" },
    { "wait": 900 },
    { "assertText": "跟随系统" },
    { "assertText": "English" },
    { "press": "down" },
    { "wait": 400 },
    { "press": "down" },
    { "wait": 400 },
    { "press": "enter", "note": "应用 English" },
    { "wait": 1100 },
    { "assertText": "Interface language" },
    { "assertText": "Color theme" },
    { "assertText": "English", "note": "语言一行的值已经变成 English" },
    { "shot": "tui-preferences-en" },
    { "press": "down", "note": "移到「Color theme」" },
    { "wait": 500 },
    { "press": "enter", "note": "打开主题列表" },
    { "wait": 900 },
    { "assertText": "move to preview" },
    { "assertText": "dark canvas" },
    { "press": "down" },
    { "wait": 400 },
    { "press": "down" },
    { "wait": 400 },
    { "press": "enter", "note": "应用 One Dark" },
    { "wait": 1100 },
    { "assertText": "Color theme" },
    { "assertText": "One Dark" },
    { "press": "esc", "note": "关掉偏好设置" },
    { "wait": 900 },
    { "assertText": "Describe the task", "note": "输入框提示已经是英文" },
    { "assertText": "idle", "note": "状态栏也是英文" },
    { "shot": "tui-en-after-switch" },
    { "restart": true, "wait": 2600, "note": "退出再启动，同一份 FUTURE_HOME" },
    { "assertText": "Describe the task", "note": "语言在重启后仍在" },
    { "assertText": "idle" },
    { "press": "ctrl+q" },
    { "wait": 1000 },
    { "assertText": "Interface language" },
    { "assertText": "One Dark", "note": "主题在重启后仍在" },
    { "shot": "tui-preferences-after-restart" }
  ],
  "judge": {
    "criteria": [
      "偏好设置浮层每一行都有可读的标签与当前值，没有空白行或占位符",
      "切换语言后界面文案整体是英文，且没有中英混排到自己都读不懂的程度",
      "切到 One Dark 后可以明显看出配色不是默认 Dark（背景/前景有变化）",
      "重启后的画面与重启前一致：仍是英文界面，配色主题仍是 One Dark",
      "整个过程中没有残留的加载态或报错文案"
    ],
    "maxImages": 8
  }
}
